GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Supabase / PostgreSQL
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DATABASE_URL=postgresql://postgres:password@xxxxx.supabase.co:5432/postgres

# Concurrency
MAX_JOBS_PER_WORKER=4
MAX_JOBS_PER_ORG=2

# Dashboard Basic Auth (production)
# Generate the password hash on your server with:
#   caddy hash-password --plaintext "your_password"
# Then paste the output here (starts with $2a$...)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH='$2a$14$replace_with_actual_hash'
